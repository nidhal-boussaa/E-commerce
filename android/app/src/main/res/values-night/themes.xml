<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème MaterialComponents obligatoire pour TextInputLayout -->
    <style name="Theme.EShop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Palette Rouge E-Shop -->
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorPrimaryVariant">@color/red_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/red_accent</item>
        <item name="colorSecondaryVariant">@color/red_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Fond et Surfaces -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Barre de Statut claire -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>