<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- État sélectionné (quand l'utilisateur clique dans le champ) : Bordure rouge -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1.5dp"
                android:color="@color/red_primary" />
            <corners android:radius="14dp" />
            <padding
                android:bottom="12dp"
                android:left="16dp"
                android:right="16dp"
                android:top="12dp" />
        </shape>
    </item>

    <!-- État normal par défaut : Bordure grise discrète -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="#E0E0E0" />
            <corners android:radius="14dp" />
            <padding
                android:bottom="12dp"
                android:left="16dp"
                android:right="16dp"
                android:top="12dp" />
        </shape>
    </item>
</selector>