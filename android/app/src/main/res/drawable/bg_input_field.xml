<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- État sélectionné / Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1.5dp"
                android:color="@color/red_primary" />
            <corners android:radius="24dp" />
            <padding
                android:bottom="12dp"
                android:left="18dp"
                android:right="18dp"
                android:top="12dp" />
        </shape>
    </item>
    <!-- État normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/border_input" />
            <corners android:radius="24dp" />
            <padding
                android:bottom="12dp"
                android:left="18dp"
                android:right="18dp"
                android:top="12dp" />
        </shape>
    </item>
</selector>