<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Image Produit Carrée -->
        <androidx.cardview.widget.CardView
            android:layout_width="86dp"
            android:layout_height="86dp"
            app:cardBackgroundColor="@color/background_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivFavoriteProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Produit"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shopping_bag" />
        </androidx.cardview.widget.CardView>

        <!-- Détails : Catégorie, Titre, Stock, Prix -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFavoriteCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="HIGH-TECH" />

            <TextView
                android:id="@+id/tvFavoriteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Écouteurs Pro Red" />

            <TextView
                android:id="@+id/tvFavoriteStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="✓ En stock"
                android:textColor="@color/success_color"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFavoritePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/red_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="49.900 DT" />
        </LinearLayout>

        <!-- Actions Droite : Supprimer & Ajouter au Panier -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center|end"
            android:orientation="vertical">

            <!-- Bouton Poubelle pour supprimer des favoris -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnRemoveFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardBackgroundColor="@color/red_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Supprimer"
                    android:padding="7dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/red_primary" />
            </androidx.cardview.widget.CardView>

            <!-- Bouton Ajouter au Panier direct -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAddToCart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/red_primary"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ajouter au Panier"
                    android:padding="8dp"
                    android:src="@drawable/ic_shopping_cart"
                    app:tint="@color/white" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>