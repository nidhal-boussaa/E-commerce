<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- État focus actif : bordure rouge vif -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/surface_white" />
            <stroke android:width="1.8dp" android:color="@color/primary_red" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>
    <!-- État normal par défaut : bordure rouge claire / rose pastel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/surface_white" />
            <stroke android:width="1.2dp" android:color="@color/primary_red_stroke" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>
</selector>