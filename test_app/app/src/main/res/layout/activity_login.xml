<?xml version="1.0" encoding="utf-8"?>
<!-- 
  E-Shop Android E-commerce
  Écran : Connexion (Login)
  Inspiré du design moderne rouge & blanc avec courbes décoratives
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_white"
    tools:context=".activities.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Vague décorative supérieure gauche / haut -->
        <View
            android:id="@+id/viewTopWave"
            android:layout_width="220dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_wave_top_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo E-Shop (Panier + Vitesse) -->
        <LinearLayout
            android:id="@+id/layoutLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgCartLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_shopping_cart_red"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="32sp"
                android:textStyle="bold|italic"
                android:textColor="@color/primary_red"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvAppTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Illustration centrale E-commerce (Smartphone + Sacs de shopping + Badge %) -->
        <ImageView
            android:id="@+id/imgHeroIllustration"
            android:layout_width="260dp"
            android:layout_height="170dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_hero_ecommerce"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toBottomOf="@id/layoutLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Titre de la section : Connexion -->
        <TextView
            android:id="@+id/tvTitleConnexion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_login"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgHeroIllustration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Conteneur des formulaires -->
        <LinearLayout
            android:id="@+id/layoutForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitleConnexion">

            <!-- Champ Email avec icône -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edit_text_rounded_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_mail"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/hint_email" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Champ Mot de passe avec toggle visibilité -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/edit_text_rounded_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@string/hint_password" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Afficher ou masquer mot de passe" />
            </LinearLayout>

            <!-- Bouton rouge Se connecter -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary_red"
                android:text="@string/btn_login"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <!-- Séparateur "Vous n'avez pas de compte ?" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="22dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="@color/primary_red_stroke" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_no_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="@color/primary_red_stroke" />
            </LinearLayout>

            <!-- Lien rouge "S'inscrire" -->
            <TextView
                android:id="@+id/tvGoToSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/link_signup"
                android:textColor="@color/primary_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Vagues décoratives rouges inférieures -->
        <ImageView
            android:id="@+id/imgBottomWave"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_wave_bottom"
            app:layout_constraintTop_toBottomOf="@id/layoutForm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>